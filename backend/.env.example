# ── Clerk Authentication (Backend) ──────────────────────────────────────────
# Get from: https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=your_clerk_secret_key_here

# ── Dodo Payments ────────────────────────────────────────────────────────────
# Get from: https://dashboard.dodopayments.com → Developers → API Keys
DODO_API_KEY=your_dodo_api_key_here

# Product ID from Dodo dashboard (create a one-time product for $4.99)
DODO_PRODUCT_ID=your_dodo_product_id_here

# Webhook secret from Dodo dashboard → Webhooks → Your endpoint secret
DODO_WEBHOOK_SECRET=your_dodo_webhook_secret_here

# ── App URL (used in checkout redirect URLs) ─────────────────────────────────
APP_URL=https://yourdomain.vercel.app

# ── Vercel KV (auto-injected on Vercel, needed locally for testing) ──────────
KV_URL=redis://...
KV_REST_API_URL=https://...
KV_REST_API_TOKEN=...
KV_REST_API_READ_ONLY_TOKEN=...
